@using System.Threading.Tasks
@using Frontend.Dtos
@using Frontend.Services
@using Microsoft.AspNetCore.Components.Authorization;
@inject HttpService httpService;
@inject AuthenticationStateProvider authProvider
@inject NavigationManager Nav;

@page "/"

<AuthorizeView>
    <Authorized>
        <p>You were logged in</p>
        <button class="btn btn-danger p-2 mt-3" @onclick="Logout">Logout</button>
    </Authorized>
    <NotAuthorized Context="NotAuth">
        @if(!form){
            <EditForm Model="loginDto" OnValidSubmit="LoginAsync">
                <DataAnnotationsValidator />
                <h2>Login</h2>
                <div>
                    <label for="username">Username</label>
                    <InputText @bind-Value="loginDto.Username" id="username" />
                </div>
                <div>
                    <label for="password">Password</label>
                    <InputText @bind-Value="loginDto.Password" id="password" />
                </div>
                <button class="btn btn-success mt-2 p-2" type="submit">Login</button>
                <ValidationSummary class="mt-4" />
            </EditForm>
        }
        else {
            <EditForm Model="signupDto" OnValidSubmit="SignUpAsync">
                <DataAnnotationsValidator />
                <h2>Sign Up</h2>
                <div>
                    <label for="username">Username</label>
                    <InputText @bind-Value="signupDto.Username" id="username" />
                </div>
                <div>
                    <label for="username">Email</label>
                    <InputText @bind-Value="signupDto.Email" id="username" />
                </div>
                <div>
                    <label for="username">Password</label>
                    <InputText @bind-Value="signupDto.Password" id="username" />
                </div>
                <div>
                    <label for="password">Confirm Password</label>
                    <InputText @bind-Value="signupDto.ConfirmPassword" id="password" />
                </div>
                <button class="btn btn-success mt-2 p-2" type="submit">Login</button>
                <ValidationSummary />
            </EditForm>
        }
        <div>
            <p class="p-2">@errorMsg</p>
            <section class="d-flex justify-content-center pt-4 border-top align-items-center">
                <div class="d-flex align-items-center border-end pe-3">
                    <p class="mb-0 me-2">@(form ? "If you already have an account, please -" : "If you do not have an account, please -")</p>
                    <button @onclick="switchForm" class="btn btn-info">@(form ? "Login" : "Sign Up")</button>
                </div>
                <div class="d-flex align-items-center ps-3">
                    <p class="mb-0 me-2">forgot your "Username" or "Password"?</p>
                    <button @onclick="@(() => Nav.NavigateTo("/emailverify"))" class="btn btn-primary">Reset</button>
                </div>
            </section>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool form = false;
    private string errorMsg = string.Empty;

    public LoginDto loginDto = new LoginDto();
    public SignUpDto signupDto = new SignUpDto();

    public async Task Logout(){
        await ((JwtAuthStateProvider)authProvider).Logout();
    }

    public void switchForm()
    {
        form = !form; // Simple toggle
        StateHasChanged();
    }

     public async Task LoginAsync(){
        try {
            errorMsg = "";
            string? response = await httpService.LoginAsync(loginDto);
            await ((JwtAuthStateProvider)authProvider).MarkUserAsAuthenticatedAsync(response);
            StateHasChanged();
        } catch (Exception Ex) {
            errorMsg = Ex.Message;
            StateHasChanged();
        }
     }

     public async Task SignUpAsync(){
        string? response = await httpService.SignUpAsync(signupDto);
        await ((JwtAuthStateProvider)authProvider).MarkUserAsAuthenticatedAsync(response);
     }
}